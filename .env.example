# =============================================================================
# SCENARIO DEBUGGER — ENVIRONMENT CONFIGURATION
# =============================================================================
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Edit .env with your actual values
#   3. NEVER commit .env to git — it contains secrets
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — set these before first run
# -----------------------------------------------------------------------------

# Base directory for all app data (uploads, outputs, logs, database)
APP_BASE_PATH=/opt/scenario-debugger

# Secret key for JWT token signing — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_BEFORE_DEPLOYING_USE_SECRETS_TOKEN_HEX

# -----------------------------------------------------------------------------
# OPTIONAL — defaults are fine for most deployments
# -----------------------------------------------------------------------------

APP_NAME=ScenarioIQ
API_HOST=0.0.0.0
API_PORT=8000

# Frontend origins (comma-separated, no spaces)
# Add your server's IP or domain
CORS_ORIGINS=http://localhost:3000,http://192.168.0.32:3000

JWT_EXPIRY_MINUTES=480
MAX_UPLOAD_MB=50
PIPELINE_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# AI recommendation — 2-line suggestion generated from the diagnosed root cause
# Requires a local Ollama server: https://ollama.com  (ollama pull llama3.1:8b)
# If unreachable, jobs still complete normally — the recommendation is skipped.
# -----------------------------------------------------------------------------

# On CPU-only hardware a cold model load takes ~40s, generation another 10-20s;
# on GPU it's ~2-5s. The service asks Ollama to keep the model warm for 30min
# between calls so only the first call (or one after a long idle gap) is slow.
AI_RECOMMENDATION_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_S=90

# -----------------------------------------------------------------------------
# LDAP — leave disabled unless you have an LDAP server
# -----------------------------------------------------------------------------

LDAP_ENABLED=false
# LDAP_SERVER=ldap://your-bank-ldap-server:389
# LDAP_BASE_DN=dc=yourbank,dc=com
# LDAP_BIND_DN=cn=service-account,dc=yourbank,dc=com
# LDAP_BIND_PASSWORD=your-service-account-password

# -----------------------------------------------------------------------------
# Oracle DB connection
# -----------------------------------------------------------------------------

DB_USERNAME=FCCMATOMIC
DB_PASSWORD=oracle123
DB_DSN=192.168.3.31:1521/demofsaa.jmrinfotechble.com
DB_CONNECT_TIMEOUT_S=10
DB_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# SSH server (used for set_batch_date pipeline step)
# -----------------------------------------------------------------------------

SERVER_HOST=192.168.3.32
SERVER_PORT=22
SERVER_USERNAME=oracle
SERVER_PASSWORD=Oracle@123
MANTAS_BATCH_PATH=/u01/OFSAA/FICHOME/database/db_tools/bin

# -----------------------------------------------------------------------------
# Output path
# -----------------------------------------------------------------------------

OUTPUT_BASE_PATH=/opt/scenario-debugger/outputs
MAX_SQL_FILE_BYTES=52428800
