   <TABLE NAME="KDD_SEQ_PTTRN" CLEAN="YES">
        <ROW>
         <COLUMN NAME="PTTRN_ID" TYPE="NUMBER" PK="YES"  NULL="NO">114000302</COLUMN>
         <COLUMN NAME="DESC_TX" TYPE="CHAR" PK="NO"  NULL="NO">Retrieve all high-risk instructions</COLUMN>
         <COLUMN NAME="PTTRN_TX" TYPE="LONG" PK="NO"  NULL="NO"><![CDATA[<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE rule-pattern PUBLIC "-//SRA//DTD Patterns//EN" "pattern.dtd">
<rule-pattern action="BreakAction" focus="CUSTOMER" id="p1">
  <datasets>
    <dataset href="/datasets/114000709" id="ds2" name="IML_HighRiskInstructions_Main"/>
  </datasets>
  <scenario class="Institutional Money Laundering" description="Instructions specify the details about how trades are cleared and settled, and consequently direct flows of funds and securities into and out of accounts. This scenario identifies standing and trade-specific instructions that involve external entities, geographies, instruction channels, or instruction products that are deemed risky." focus="CUSTOMER" href="/scenarios/114000021" id="s4" name="(IML/CU) High Risk Instructions" scenarioid="114000021" scnroctldid="IML-HighRiskInstructions-dINST" shortname="High Risk Instructions"/>
  <roles>
    <role format="INTEGER" highlight="Y" name="Activity_Risk_Lvl">
Instruction Risk =
    </role>
    <role format="INTEGER" highlight="Y" name="Instrn_Ct">
Tot Hi Instruction Ct =
    </role>
    <role format="" highlight="N" name="Effctv_Risk_Lvl">Effctv Risk Lvl</role>
    <role format="" highlight="N" name="CUSTOMER">CUSTOMER</role>
  </roles>
  <rule>
    <row dataset="ds2" norecord="no">
      <comment>Retrieve all high-risk instructions</comment>
      <binding name="Instrn_Ct">
        COUNT()<comment>
Total number of matched instructions
        </comment>
      </binding>
      <binding name="Activity_Risk_Lvl">
        MAX(INSTR_ACTVY_RISK_NB)<comment>
The maximum activity risk level  associated with the matched instruction(s) producing the alert
        </comment>
      </binding>
      <binding name="Effctv_Risk_Lvl">
        CUST_EFCTV_RISK_NB<comment>
Value of effective risk level attibut for the focal entity
        </comment>
      </binding>
      <binding name="Cstmr">CUST_INTRL_ID</binding>
      <binding name="CUSTOMER">CUST_INTRL_ID</binding>
    </row>
    <focal-attribute cluster="yes">CUST_INTRL_ID</focal-attribute>
  </rule>
</rule-pattern>
]]></COLUMN>
       </ROW>
   </TABLE>
   <TABLE NAME="KDD_TRANSFORM" CLEAN="YES">
