         <COLUMN NAME="DATASET_NM" TYPE="CHAR" PK="NO"  NULL="NO">IML_HighRiskInstructions_Main</COLUMN>
         <COLUMN NAME="USER_ID" TYPE="CHAR" PK="NO"  NULL="NO">@MINER@</COLUMN>
         <COLUMN NAME="CREATE_DT" TYPE="DATE" PK="NO"  NULL="NO">2004-02-16 17:54:59.0</COLUMN>
         <COLUMN NAME="REALIZED_NM" TYPE="CHAR" PK="NO"  NULL="NO">@MINER@.DSVIEW114000709</COLUMN>
         <COLUMN NAME="SQL_FL" TYPE="CHAR" PK="NO"  NULL="NO">T</COLUMN>
         <COLUMN NAME="SQL_CMMNT" TYPE="CHAR" PK="NO"  NULL="YES"></COLUMN>
         <COLUMN NAME="SCNRO_ID" TYPE="NUMBER" PK="NO"  NULL="NO">114000021</COLUMN>
         <COLUMN NAME="SQL_TX" TYPE="LONG" PK="NO"  NULL="NO"><![CDATA[SELECT 
     a.INSTR_SEQ_ID
--   , a.DATA_DUMP_DT
--   , b.ACCT_INTRL_ID
   , a.INSTR_ACTVY_RISK_NB
   , c.CUST_EFCTV_RISK_NB
   , c.CUST_INTRL_ID 
FROM @MANTAS@.KDD_CAL d inner join 
             (@BUSINESS@.INSTRUCTION a inner join 
                      (@BUSINESS@.CUST c inner join @BUSINESS@.ACCT b on c.CUST_INTRL_ID=b.PRMRY_CUST_INTRL_ID) 
                 on a.ACCT_INTRL_ID=b.ACCT_INTRL_ID) on a.DATA_DUMP_DT = d.CLNDR_DT
                                                  and d.CLNDR_NM='SYSCAL'
                                                  and d.CLNDR_DAY_AGE=0
WHERE 
      a.INSTR_ACTVY_RISK_NB >= @Min_Instrctn_Risk_Lvl
  and c.CUST_EFCTV_RISK_NB <> -2
  and b.MANTAS_ACCT_HOLDR_TYPE_CD='CI'
  and (@All_Jurisdictions_Fl='Y' or c.JRSDCN_CD in (@Incl_Jurisdictions_Lst))
  and (@All_Acct_Type_Fl='Y' or b.ACCT_TYPE1_CD in (@Incl_Acct_Type_Lst))]]></COLUMN>
       </ROW>
   </TABLE>
