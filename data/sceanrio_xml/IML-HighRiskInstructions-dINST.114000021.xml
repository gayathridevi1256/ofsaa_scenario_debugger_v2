         <COLUMN NAME="REALIZED_FL" TYPE="CHAR" PK="NO"  NULL="NO">Y</COLUMN>
         <COLUMN NAME="TRANSFORM_TX" TYPE="LONG" PK="NO"  NULL="NO"><![CDATA[restrict where (((((((113001100.CLNDR_DAY_AGE == 0)  and  (113001061.INSTR_ACTVY_RISK_NB >= @Min_Instrctn_Risk_Lvl))  and  (113001027.CUST_EFCTV_RISK_NB != -2))  and  (113001001.MANTAS_ACCT_HOLDR_TYPE_CD == 'CI'))  and  (('@All_Jurisdictions_Fl' == 'Y')  or  113001027.JRSDCN_CD in (@Incl_Jurisdictions_Lst)))  and  (('@All_Acct_Type_Fl' == 'Y')  or  113001001.ACCT_TYPE1_CD in (@Incl_Acct_Type_Lst)))  and  (113001100.CLNDR_NM == 'SYSCAL'))]]></COLUMN>
