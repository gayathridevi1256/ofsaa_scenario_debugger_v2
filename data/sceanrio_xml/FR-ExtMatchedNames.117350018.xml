   <TABLE NAME="KDD_SEQ_PTTRN" CLEAN="YES">
        <ROW>
         <COLUMN NAME="PTTRN_ID" TYPE="NUMBER" PK="YES"  NULL="NO">117350023</COLUMN>
         <COLUMN NAME="DESC_TX" TYPE="CHAR" PK="NO"  NULL="NO">Getting data for the matched accounts</COLUMN>
         <COLUMN NAME="PTTRN_TX" TYPE="LONG" PK="NO"  NULL="NO"><![CDATA[<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE rule-pattern PUBLIC "-//SRA//DTD Patterns//EN" "pattern.dtd">
<rule-pattern action="BreakAction" focus="ACCOUNT" id="p1">
  <datasets>
    <dataset href="/datasets/117351161" id="ds2" name="FR_ExtMatchedNames_AC"/>
  </datasets>
  <scenario class="Fraud" description="Financial institutions regularly scan their Accounts/Customer files against watch lists as part of their due diligence process to ensure they know their customers and have limited their exposure to the risk of fraud. Entities are considered high risk based on their presence on a public (governmental or quasi-governmental), third party repositories which flag known or suspected fraudsters, or private (internal) watch lists, such as those of known fraud suspects or perpetrators. Several Mantas clients use third party platforms to identify potentially risky entities based on fuzzy name matching.
The objective of this scenario is to generate an alert for each matched record (customer/account name match). This provides a single repository for the alerts to facilitate analysis and include the information in an entity&apos;s alert history so that these matches might be considered in prior match counts in the scoring of future alerts and for audit purposes, enabling closer scrutiny of the customer or account activities, as well as flagging for possible closure." focus="ACCOUNT" href="/scenarios/117350018" id="s4" name="(FR/AC) Externally Matched Names" scenarioid="117350018" scnroctldid="FR-ExtMatchedNames" shortname="Externally Matched Names - FR"/>
  <roles>
    <role format="STRING" highlight="Y" name="List_Risk_Match_Text">
List Risk Match Text =
    </role>
    <role format="INTEGER" highlight="Y" name="List_Risk">List Risk =</role>
    <role format="STRING" highlight="Y" name="List_Name">List Name =</role>
    <role format="%" highlight="Y" name="Match_Pct">Match% =</role>
    <role format="REAL2" highlight="Y" name="Match_Th">Match Th =</role>
    <role format="STRING" highlight="Y" name="Address_Information">
      Address =</role><role format="STRING" highlight="Y" name="City">City =
    </role>
    <role format="STRING" highlight="Y" name="Country">Country =</role>
    <role format="" highlight="N" name="Effctv_Risk_Lvl">Effctv Risk Lvl</role>
    <role format="" highlight="N" name="ACCOUNT">ACCOUNT</role>
  </roles>
  <rule>
    <row dataset="ds2" norecord="yes">
      <comment>Getting data for the matched accounts</comment>
      <constraint>1 == 1</constraint>
      <binding name="List_Risk_Match_Text">
        MATCH_TX<comment>
Text on the Watch List that matched the text on the record.
        </comment>
      </binding>
      <binding name="List_Risk">
        LEVEL_NB<comment>
Level of risk attributed to this record via the matched list and assigned by the generating system.
        </comment>
      </binding>
      <binding name="List_Name">
        LIST_SRC_NM<comment>
Name of Watch List that contains an entry that matched this record.
        </comment>
      </binding>
      <binding name="Match_Pct">
        MATCH_PT<comment>
Percentage match between the text on the Watch List and the text on the record.
        </comment>
      </binding>
      <binding name="Match_Th">
        MATCH_TSHLD_PT<comment>
Threshold setting on the generating system for the Match percent to consider a valid match.
        </comment>
      </binding>
      <binding name="Acct_Intrl_Id">ACCT_INTRL_ID</binding>
      <binding name="Effctv_Risk_Lvl">ACCT_EFCTV_RISK_NB</binding>
      <binding name="Address_Information">CSTM_1_TX</binding>
      <binding name="City">CSTM_2_TX</binding>
      <binding name="Country">CSTM_3_TX</binding>
      <binding name="ACCOUNT">ACCT_INTRL_ID</binding>
    </row>
    <focal-attribute cluster="no">ACCT_INTRL_ID</focal-attribute>
  </rule>
</rule-pattern>
]]></COLUMN>
       </ROW>
   </TABLE>
