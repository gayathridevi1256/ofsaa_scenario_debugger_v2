         <COLUMN NAME="CREATE_DT" TYPE="DATE" PK="NO"  NULL="NO">2009-11-10 10:42:28.0</COLUMN>
         <COLUMN NAME="REALIZED_NM" TYPE="CHAR" PK="NO"  NULL="NO">@MINER@.DSVIEW117351161</COLUMN>
         <COLUMN NAME="SQL_FL" TYPE="CHAR" PK="NO"  NULL="NO">T</COLUMN>
         <COLUMN NAME="SQL_CMMNT" TYPE="CHAR" PK="NO"  NULL="YES"></COLUMN>
         <COLUMN NAME="SCNRO_ID" TYPE="NUMBER" PK="NO"  NULL="NO">117350018</COLUMN>
         <COLUMN NAME="SQL_TX" TYPE="LONG" PK="NO"  NULL="NO"><![CDATA[-- 09.02.2006
-- ML-ExtMatchedNames-fAC
-- The third party program scans account data against Watch Lists 
-- and generates a file of the detected name matches with the appropriate 
-- account internal ID that meet the relevant thresholds (match precision).
--
-- Used thresholds:
-- Look_Back_Period, All_Ntity_Src_Fl, Incl_Ntity_Src_Lst
--
--
select
      a.ACCT_INTRL_ID,
      a.ACCT_EFCTV_RISK_NB,
      me.CSTM_1_TX,
      me.CSTM_2_TX,
      me.CSTM_3_TX,
      me.MTCHD_NTITY_SEQ_ID,
      me.NTITY_INTRL_ID,
      --me.LIST_DESC_TX,   PR31844  11/07/2006
      me.MATCH_TX,           --PR31844   11/07/2006
      me.LEVEL_NB,
      me.LIST_SRC_NM,
      me.MATCH_PT,
      me.MATCH_TSHLD_PT
 from
      @BUSINESS@.MATCHED_ENTITY me
      inner join @BUSINESS@.ACCT a on (me.NTITY_INTRL_ID = a.ACCT_INTRL_ID and me.NTITY_TYPE_CD = 'ACCT')
where -- Need for include "Lookback Period" threshold
      me.DATA_DUMP_DT <= (select kc.CLNDR_DT from @MANTAS@.KDD_CAL kc where kc.CLNDR_DAY_AGE=0 and kc.CLNDR_NM = 'SYSCAL')
  and me.DATA_DUMP_DT  > (select add_days(kc.CLNDR_DT, -@Look_Back_Period) from @MANTAS@.KDD_CAL kc where kc.CLNDR_DAY_AGE=0 and kc.CLNDR_NM = 'SYSCAL')
-- Included Source Systems.
-- List of all source systems that the scenario covers. The client defines the allowable values.
-- All Source Systems.
-- Parameter that allows coverage of all source systems without
-- enumerating them in the Included Source Systems  threshold:
-- Y: Cover all jurisdiction codes regardless of the Included Source Systems threshold value.
-- N: Cover only those jurisdictions that are listed in the Included Source Systems threshold.
and (@All_Ntity_Src_Fl = 'Y' or a.src_sys_cd in (@Incl_Ntity_Src_Lst))]]></COLUMN>
       </ROW>
   </TABLE>
